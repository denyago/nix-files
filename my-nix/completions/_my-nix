#compdef my-nix

_my_nix() {
  local -a commands
  commands=(
    'apply:Apply nix-darwin configuration'
    'commit:Commit and push changes across all repos'
    'upgrade:Upgrade nix and Homebrew packages'
    'do-release-upgrade:Bump to the latest release train'
    'cleanup:Clean up nix generations and store'
  )

  _arguments -C \
    '1:command:->cmds' \
    '*::args:->args' && return 0

  case $state in
    cmds)
      _describe 'command' commands
      ;;
    args)
      case $words[1] in
        cleanup)
          _arguments \
            '--keep[Number of generations to keep]:count' \
            '--all[Delete all generations except current]'
          ;;
      esac
      ;;
  esac
}

_my_nix "$@"
